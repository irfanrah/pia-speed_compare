# =============================================================
# Soil Qwen3.5 vLLM Server 환경 설정
# 이 파일을 .env로 복사한 뒤 환경에 맞게 수정하세요.
#   cp .env.example .env
# =============================================================

# === GPU / 베이스 이미지 ===
# GPU 아키텍처별 베이스 이미지:
#   Blackwell (B200 등):          vllm/vllm-openai:cu130-nightly
#   Hopper / Ampere (H100, A100): vllm/vllm-openai:latest
VLLM_IMAGE=vllm/vllm-openai:cu130-nightly
NVIDIA_VISIBLE_DEVICES=0
GPU_COUNT=1

# === vLLM 모델 ===
# 모델 ID (HuggingFace). 모델 크기별 예시:
#   0.8B: Qwen/Qwen3.5-0.8B  (~1.6GB VRAM, 가장 가벼움)
#   2B:   Qwen/Qwen3.5-2B    (~4GB VRAM)
#   4B:   Qwen/Qwen3.5-4B    (~8GB VRAM)
#   9B:   Qwen/Qwen3.5-9B    (~18GB VRAM)
VLLM_MODEL=Qwen/Qwen3.5-0.8B

# === GPU 메모리 설정 (중요) ===
# GPU_MEMORY_UTILIZATION: vLLM이 사용할 GPU 메모리 비율 (0.0~1.0)
#   0.9 = GPU 메모리의 90% 사용 (기본값, 단독 실행 시)
#   0.5 = 50%만 사용 (다른 모델과 GPU 공유 시)
GPU_MEMORY_UTILIZATION=0.3

# KV_CACHE_MEMORY_BYTES: KV 캐시에 할당할 메모리 상한
#   이 값을 설정하면 GPU_MEMORY_UTILIZATION보다 우선 적용됨
#   1G  = 1GB (최소 구성, 동시 처리 수 제한)
#   10G = 10GB (권장, 적절한 동시 처리)
#   설정하지 않으면 GPU_MEMORY_UTILIZATION 비율만큼 자동 할당
KV_CACHE_MEMORY_BYTES=1G

# === 추론 파라미터 ===
TENSOR_PARALLEL_SIZE=1          # GPU 병렬 수 (멀티 GPU 시 2, 4 등)
MAX_MODEL_LEN=8192              # 최대 컨텍스트 길이 (토큰)
MAX_NUM_SEQS=128                # 동시 처리 가능한 최대 시퀀스 수
MAX_NUM_BATCHED_TOKENS=131072   # 배치당 최대 토큰 수
# EXTRA_VLLM_ARGS: 추가 vLLM 인자
#   thinking 비활성화 (4B 이상 모델에서 필수, 2B는 해당 없음):
#     EXTRA_VLLM_ARGS=--default-chat-template-kwargs '{"enable_thinking": false}'
EXTRA_VLLM_ARGS=--default-chat-template-kwargs '{"enable_thinking": false}'

# === HuggingFace ===
# HF_TOKEN=hf_xxxxxxxx          # gated 모델 접근용 토큰
# HF_CACHE_DIR=~/.cache/huggingface  # 모델 캐시 경로

# === 포트 ===
# VLLM_PORT: 서버가 리슨하는 포트 (컨테이너 내부 + 호스트 매핑 모두 이 값 사용)
#   config.py의 SOIL_QWEN35_VLLM_PORT와 동일하게 맞춰야 함
VLLM_PORT=9001
