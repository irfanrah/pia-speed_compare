# =============================================================================
# Qwen3VLE Embedding Server — environment template
#
# Copy this file to `.env` (next to docker-compose.yml) and edit values as
# needed, then `docker compose up -d --build`. Variables not listed here fall
# back to the defaults baked into docker-compose.yml / config.py.
# =============================================================================


# --- Required: model checkpoint location -------------------------------------
# Host directory mounted into the container at /models. The server resolves
# MODEL_PATH=/models/${MODEL_NAME}, so this is the *parent* of the model dir.
# Compose will refuse to start if MODEL_DIR is unset.
MODEL_DIR=/home/piawsa6000/nas192/Research_materials/jordan/Product-AI-mono/assets/model

# Subdirectory under MODEL_DIR that holds the checkpoint (config.json,
# model.safetensors, tokenizer files). Inside the container this resolves to
# /models/${MODEL_NAME}.
#   Qwen3-VL-Embedding-2B          — BF16 baseline, ~5 GB weights
#   Qwen3-VL-Embedding-2B-FP8      — FP8 quantized, ~2.5 GB, needs Hopper/Ada
#   Qwen3-VL-Embedding-2B-W8A8     — INT8 W8A8 variant
MODEL_NAME=Qwen3-VL-Embedding-2B-FP8


# --- HuggingFace auto-download (only used when MODEL_DIR is empty) -----------
# entrypoint.sh fetches the checkpoint from HF Hub if /models/${MODEL_NAME}
# is missing model.safetensors. Skip this section if you've already pre-
# populated MODEL_DIR (rsync from another host, etc.).

# Text-features JSON shipped alongside the checkpoint, used by the validator.
# Pair it with the matching weights: VLE_BF16_text_features.json for BF16,
# VLE_FP8_text_features.json for FP8, etc.
HF_TEXT_FEATURES_FILE=VLE_FP8_text_features.json

# Uncomment + set if the HF repo is gated or private.
# HF_AUTH_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Override the repo path; defaults to ${HF_NAMESPACE}/${MODEL_NAME}.
# HF_NAMESPACE=PIA-SPACE-LAB
# HF_MODEL_REPO_ID=PIA-SPACE-LAB/Qwen3-VL-Embedding-2B-FP8
# HF_TEXT_FEATURES_REPO_ID=PIA-SPACE-LAB/Qwen3-VL-Embedding-2B-FP8


# --- vLLM engine tuning ------------------------------------------------------
# Max in-flight embed requests gated by the FastAPI semaphore. AsyncLLMEngine
# batches admitted requests internally, so this caps memory, not throughput.
VLLM_MAX_CONCURRENCY=32

# Activation dtype. Stays BF16 even for FP8 weight checkpoints — FP8 only
# applies to weights, activations remain BF16. Don't set this to "fp8".
# DTYPE=bfloat16

# Fraction of GPU memory vLLM is allowed to claim during init. Bump if you
# see vLLM "OutOfMemory" at startup; drop if other processes share the GPU.
# GPU_MEMORY_UTILIZATION=0.3

# Max prompt length (tokens) the engine will accept. 8192 fits the longest
# T=16 multimodal prompt comfortably; raise only if you need longer context.
# MAX_MODEL_LEN=8192

# vLLM's hard cap on multi-modal items per request. The embedding API
# always sends one video (or one image when T=1), so 1 is correct here.
# LIMIT_MM_PER_PROMPT_VIDEO=1
# LIMIT_MM_PER_PROMPT_IMAGE=1

# KV cache size — accepts byte suffixes (1G, 512M, 1024K). Leave empty to let
# vLLM auto-size from GPU_MEMORY_UTILIZATION.
# KV_CACHE_MEMORY_BYTES=1G

# Hard caps on vLLM's scheduler. Leave empty to use vLLM defaults; set them
# only if you're tuning for a specific memory/throughput tradeoff.
# MAX_NUM_SEQS=
# MAX_NUM_BATCHED_TOKENS=


# --- Hardware ----------------------------------------------------------------
# Number of GPUs to reserve for the container. Leave at 1 unless you're
# running tensor-parallel (not supported by this pooling engine).
# GPU_COUNT=1

# Which physical GPU(s) the container sees. Use "0", "1", "0,1", etc. — maps
# directly to nvidia-container-runtime's CUDA_VISIBLE_DEVICES.
# NVIDIA_VISIBLE_DEVICES=0


# --- Networking --------------------------------------------------------------
# Host port published to the container's 8210. Change if 8210 collides with
# another service (e.g. when running multiple Qwen3VLE replicas on one host).
# SERVER_PORT=8210


# --- vLLM base image (build-time only) ---------------------------------------
# Set this to switch the Dockerfile base when rebuilding for a specific GPU
# architecture. Stable default is v0.14.0; see docker-compose.yml for the
# Blackwell / Hopper / Ampere matrix.
# VLLM_IMAGE=vllm/vllm-openai:v0.14.0
