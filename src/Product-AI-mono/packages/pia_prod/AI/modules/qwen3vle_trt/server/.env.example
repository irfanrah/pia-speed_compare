# ==========================================
# PIA Qwen3-VL-Embedding TRT Server Config
# ==========================================

# ------------------------------------------
# Host Volume Paths (Crucial for Docker)
# ------------------------------------------
# The absolute path to your local monorepo source code
MONO_SRC=/home/jordan/Research/Product-AI-mono

# The absolute path to the directory containing your compiled TensorRT engines
# (This folder MUST contain Vision.engine, Transformer.engine, and the tokenizer/ dir)
TRT_ENGINE_DIR=/home/jordan/Research/Product-AI-mono/assets/model/Qwen3-VL-Embedding-2B-onnx

# ------------------------------------------
# API Server Settings
# ------------------------------------------
# The port the FastAPI server will listen on (Host and Container)
SERVER_PORT=9002

# Hardware target (almost always "cuda" for TensorRT)
DEVICE=cuda

# Caps queue depth for backpressure / OOM safety — this is NOT a GPU-concurrency
# knob. The TRT execution context is single-threaded and the engine wrapper
# serialises GPU work on a single CUDA stream, so raising this only changes
# how many requests can sit waiting for the engine (and how much per-request
# memory may be in flight at once), not the inference rate.
MAX_INFLIGHT_REQUESTS=2

# ------------------------------------------
# Docker GPU Allocation
# ------------------------------------------
# Which specific GPU ID to expose to the container (e.g., "0", "1", or "all")
NVIDIA_VISIBLE_DEVICES=0

# Number of GPUs to reserve in the docker-compose deploy block
GPU_COUNT=1