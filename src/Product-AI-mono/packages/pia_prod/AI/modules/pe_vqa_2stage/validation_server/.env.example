# =============================================================
# PE VQA 2-Stage Validation Container 환경 설정
# 이 파일을 .env로 복사한 뒤 환경에 맞게 수정하세요.
#   cp .env.example .env
#
# 본 컨테이너는 자기완결형이며 외부 패키지(KTT 등)에 의존하지 않습니다.
# 외부 사용처는 자체 RabbitMQ/S3/Redis 자격증명을 아래 키에 매핑해 주입하면 됩니다.
# =============================================================

# === GPU / 베이스 이미지 ===
# GPU 아키텍처별 베이스 이미지:
#   Blackwell (B200 등):          vllm/vllm-openai:cu130-nightly
#   Hopper / Ampere (H100, A100): vllm/vllm-openai:latest
VLLM_IMAGE=vllm/vllm-openai:cu130-nightly
NVIDIA_VISIBLE_DEVICES=0
GPU_COUNT=1

# === vLLM 모델 ===
VLLM_MODEL=Qwen/Qwen3.5-0.8B
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=131072
GPU_MEMORY_UTILIZATION=0.3
KV_CACHE_MEMORY_BYTES=1G
# EXTRA_VLLM_ARGS=
# HF_TOKEN=hf_xxxxxxxx
# HF 모델 캐시 — Product-AI-mono 다른 모듈과 통일 (assets/model/huggingface).
# 절대경로 권장 (예: /home/.../Product-AI-mono/assets/model/huggingface).
# 미설정 시 ${HOME}/.cache/huggingface fallback (개발 편의).
# MODEL_HF_CACHE_DIR=/absolute/path/to/Product-AI-mono/assets/model/huggingface

# === Validation Server ===
VALIDATION_SERVER_HOST=0.0.0.0
VALIDATION_SERVER_PORT=8100
# 컨테이너 내부 vLLM 포트 — host network로 외부 vLLM과 같이 띄울 때만 변경.
# VLLM_API_BASE는 이 포트를 자동 반영해야 한다 (docker-compose가 처리).
VLLM_INTERNAL_PORT=8000
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MAX_CONCURRENCY=10
VLLM_TIMEOUT=120
VLLM_MAX_TOKENS=64

# === RabbitMQ (Product-AI-mono / KTT 표준 키) ===
BACKEND_RABBITMQ_IP=rabbitmq
BACKEND_RABBITMQ_PORT=5672
BACKEND_RABBITMQ_USER_NAME=guest
BACKEND_RABBITMQ_PASSWORD=guest
BACKEND_RABBITMQ_EXCHANGE=
PYTHON_RABBITMQ_HEARBEAT_INTERVAL=60
BACKEND_RET_RESULT_RABBITMQ_QUEUE_NAME=ret_queue_dev

# === S3 (MinIO / AWS) — ES MACS 표준 키 ===
# Latency 주의: BACKEND_S3_ENDPOINT를 빈 값으로 두고 BACKEND_S3_ACCESS_KEY를
# 채우면, boto3가 AWS 기본 엔드포인트(s3.amazonaws.com)로 fallback해 매
# 업로드가 DNS + TCP/TLS + SigV4 + retry 후 ~2s 만에 실패합니다. 그 시간이
# /api/v1/validate 응답 latency에 그대로 누적됩니다.
#
# 페널티 회피 방법 두 가지 (둘 중 하나만 적용해도 충분):
#   1. credential 비우기 — S3Uploader가 boto3 client 자체를 만들지 않음(~0ms).
#                          첫 skip 시 [S3] disabled 경고가 한 번 출력됨.
#   2. fail-fast dummy endpoint — http://127.0.0.1:1 같은 닫힌 포트로 두면
#                                  boto3가 ConnectionRefused로 수 ms 내 실패.
# 본 파일은 (1) + (2)를 동시에 적용한 belt-and-braces 구성. MinIO/AWS를 실제로
# 연결할 때 두 변수 모두 덮어쓰면 됩니다.
BACKEND_S3_ACCESS_KEY=
BACKEND_S3_SECRET_KEY=
BACKEND_S3_THUMBNAIL_BUCKET_REGION=
BACKEND_S3_ENDPOINT=http://127.0.0.1:1
BACKEND_S3_THUMBNAIL_BUCKET_NAME=thumbnail

# === Redis (UUIDTracker 영속화) — KTT 표준 키 ===
REDIS_IP=localhost
REDIS_PORT=6379
REDIS_DB=0
UUID_TTL_SECONDS=3600

# === 메시징 백엔드 선택 ===
# default는 ES MACS(kafka). KTT 등 RabbitMQ 환경에서는 반드시 rabbitmq로 override.
# - kafka    : ES MACS 환경 (Avro 스키마, fastavro schemaless 와이어 포맷) — default
# - rabbitmq : KTT 환경 (Product-AI-mono / Package-Common-AI-pia_ai_package)
MESSAGING_BACKEND=kafka

# === Kafka (MESSAGING_BACKEND=kafka일 때만 사용) ===
# ES MACS의 com.macs.events.eventStart Avro 스키마를 fastavro.schemaless_writer로 직렬화하여 publish.
# Schema Registry 미사용 — ES backend도 fastavro.schemaless_reader로 직접 디코드해 와이어 포맷이 매칭.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENT_PROCESS=event.process

# === 정책 ===
# VLM 호출 실패/타임아웃 시 알람 통과 정책 (true 권장)
PE_VQA_2STAGE_FAIL_OPEN=true
