# ============================================================================
# PE-VLE Validation Server — Local Dev Env Template
# ============================================================================
# Usage:
#   cp .env.example .env
#   docker compose up -d --build
# ============================================================================


# ============================================================================
# vLLM Model Configuration
# ============================================================================

# --- Host Path & HuggingFace Setup ---
# REQUIRED: Directory where the checkpoint and anchor JSON live on the host.
MODEL_DIR=../../../../../../assets/model

HF_NAMESPACE=PIA-SPACE-LAB
HF_AUTH_TOKEN=
# HF_MODEL_REPO_ID=PIA-SPACE-LAB/Qwen3-VL-Embedding-2B-FP8
# HF_TEXT_FEATURES_REPO_ID=
# HF_TEXT_FEATURES_FILE=VLE_FP8_text_features.json

# --- Engine Tuning ---
# DTYPE=bfloat16
# GPU_MEMORY_UTILIZATION=0.3
# VLLM_MAX_CONCURRENCY=10
# MAX_MODEL_LEN=8192
KV_CACHE_MEMORY_BYTES=1G
# MAX_NUM_SEQS=128
# MAX_NUM_BATCHED_TOKENS=8192

# --- Classifier & Server Configuration ---
# PE_VLE_FAIL_OPEN=true


# ============================================================================
# Infrastructure Configuration
# ============================================================================

# MESSAGING_BACKEND=rabbitmq

# --- RabbitMQ ---
# BACKEND_RABBITMQ_IP=host.docker.internal
# BACKEND_RABBITMQ_USER_NAME=guest
# BACKEND_RABBITMQ_PASSWORD=guest

# --- Kafka ---
# KAFKA_BOOTSTRAP_SERVERS=broker:9092
# KAFKA_TOPIC_EVENT_PROCESS=event.process

# --- Redis ---
# REDIS_IP=host.docker.internal

# --- S3 / MinIO (thumbnail uploads) ---
# When a real S3-compatible endpoint is configured, fill in credentials and
# point BACKEND_S3_ENDPOINT at it (e.g. http://minio.internal:9000).
# When no S3 is configured (local dev / smoke tests), keep the fail-fast
# dummy endpoint below. Reason: leaving BACKEND_S3_ENDPOINT empty makes
# boto3 fall back to the AWS default endpoint (s3.amazonaws.com), where
# every put_object pays ~2s of DNS + TCP/TLS + SigV4 signing + retry before
# failing — that's added straight onto each /api/v1/validate response.
# A closed-port dummy returns ConnectionRefused immediately, so the upload
# fails in a few ms instead and the validator's response time stays near
# the vLLM-only baseline.
BACKEND_S3_ENDPOINT=http://127.0.0.1:1
# BACKEND_S3_ACCESS_KEY=
# BACKEND_S3_SECRET_KEY=
# BACKEND_S3_THUMBNAIL_BUCKET_REGION=us-east-1
# BACKEND_S3_THUMBNAIL_BUCKET_NAME=thumbnail