# ============================================================================
# Report Summary Server - environment template
#
# 사용법:
#   cp .env.example .env       # 본 파일을 복사 후 환경에 맞게 수정
#   docker compose up -d       # compose가 .env 자동 로드
#
# 본 파일의 변수는 docker-compose.yml의 ${VAR:-default} 보간 + 컨테이너 내부
# shell expansion으로 vLLM CLI 인자에 매핑. 추가 vLLM 옵션은
# EXTRA_VLLM_ARGS로 자유롭게 주입 가능.
# ============================================================================


# ============================================================================
# [1] vLLM 베이스 이미지
# ============================================================================
# GPU 아키텍처별 권장 태그.
#   Blackwell  (B200, B100, RTX 5090)              → vllm/vllm-openai:cu130-nightly
#   Hopper     (H100, H200)                         → vllm/vllm-openai:latest
#   Ampere     (A100, A10, A30, RTX 30/40 시리즈)   → vllm/vllm-openai:latest
# 잘못된 태그 사용 시 CUDA 호환성 오류로 컨테이너 즉시 종료.
VLLM_IMAGE=vllm/vllm-openai:cu130-nightly


# ============================================================================
# [2] 모델 / 토큰
# ============================================================================
# HuggingFace 모델 path. vLLM이 지원하는 모든 모델 사용 가능.
# 본 서비스는 0.8B 급 VLM 가정. 더 큰 모델 사용 시 아래 자원 인자 동반 조정 필수.
VLLM_MODEL=Qwen/Qwen3.5-0.8B

# HuggingFace 액세스 토큰.
# - gated 모델 (예: meta-llama/*) 또는 private 모델 사용 시 필수.
# - 공개 모델만 쓸 때는 빈 값 유지 가능.
#
# 토큰 발급 절차:
#   1) https://huggingface.co/settings/tokens 에서 'read' 권한 토큰 생성
#   2) gated 모델 페이지에서 라이선스 동의 (모델별 1회)
#   3) 아래 줄에 토큰 입력 (따옴표 X, 공백 X)
#
# 형식: hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (총 ~37자)
# 주의: .env 는 .gitignore 에 포함되어 있어 커밋되지 않지만, 다른 곳에 노출되지 않도록 주의.
HF_TOKEN=


# ============================================================================
# [3] 병렬화 (모델 분산 / VRAM 분산)
# ============================================================================
# Tensor Parallel — 한 모델을 여러 GPU에 weight 단위로 split.
#   1     : 단일 GPU
#   2/4/8 : 다중 GPU 분산. 모델 크기 / GPU VRAM에 맞춰 선택.
# 0.8B 모델은 1로 충분. 70B 이상에서 의미 있음.
TENSOR_PARALLEL_SIZE=1

# Data Parallel — 동일 모델을 여러 GPU에 복제하여 throughput N배.
# vLLM 기본은 DP=1. MoE / 멀티모달 대용량에서 유효.
DATA_PARALLEL_SIZE=1


# ============================================================================
# [4] VRAM 상한 / KV 캐시 / dtype
# ============================================================================
# vLLM이 점유할 VRAM 상한 (0.0 ~ 1.0). 모델 weight + KV 캐시 + activation 합계.
# 너무 낮으면 KV 캐시 부족 → 동시 처리량 급락.
# 너무 높으면 다른 프로세스와 OOM 충돌.
# nvidia-smi로 부하 시 peak VRAM 측정한 뒤 (peak/total + 0.05) 정도로 시작 권장.
# GPU 모델별 베이스라인 권장값은 README.md "10. GPU 별 권장 VRAM 할당" 참고.
GPU_MEMORY_UTILIZATION=0.2

# KV 캐시에 직접 할당할 메모리 크기 (예: 1G, 4G). 빈 값이면 vLLM 자동 계산.
# 명시적 지정 시 GPU_MEMORY_UTILIZATION보다 우선.
# 동시 요청 수가 예측 가능할 때 유용.
# 0.8B 모델 + 짧은 응답 기준 1G면 동시 요청 수십 건 처리에 충분.
# 동시성을 더 키울 경우 2G/4G로 상향, GPU VRAM이 부족하면 빈 값으로 두고
# GPU_MEMORY_UTILIZATION 기반 자동 계산에 맡기는 것을 권장.
KV_CACHE_MEMORY_BYTES=1G

# 모델 weight / KV 캐시 dtype.
#   auto    : 모델 config 따름 (대부분 bf16/fp16)
#   bfloat16: Hopper 이상 권장 (정확도 안정)
#   float16 : Ampere 호환. 메모리는 동일
#   float8  : H100/B200에서 메모리 절약 (모델/체크포인트가 fp8 지원해야 함)
DTYPE=auto


# ============================================================================
# [5] 컨텍스트 / 동시 처리 한계 (VRAM과 throughput에 직결)
# ============================================================================
# 한 요청이 사용할 수 있는 최대 (input + output + 이미지) 토큰 수.
# 멀티모달의 경우 이미지 한 장이 수백~수천 토큰 차지. 4096이면 이미지 1장 +
# 짧은 텍스트 + 짧은 응답에 충분. 길게 잡을수록 KV 캐시 메모리 선형 증가.
MAX_MODEL_LEN=4096

# vLLM이 동시에 디코딩하는 시퀀스(요청) 수의 상한.
# 백엔드의 동시 호출이 이 값을 넘으면 vLLM 큐에 대기.
# 큰 값일수록 throughput↑, but VRAM↑ (각 시퀀스 KV 슬롯 점유).
# 단독 결정 인자가 아니라 MAX_NUM_BATCHED_TOKENS와 함께 batch를 구성하므로
# 둘 다 같이 조정. KV 캐시 한계(GPU_MEMORY_UTILIZATION/KV_CACHE_MEMORY_BYTES)
# 안에서만 실효성 발휘.
MAX_NUM_SEQS=64

# 한 step에서 prefill+decode가 처리하는 총 토큰 수의 상한.
# MAX_MODEL_LEN 이상이어야 단일 긴 요청 처리 가능.
# 일반적으로 MAX_MODEL_LEN * 2 ~ MAX_NUM_SEQS * 평균응답길이 사이 값.
# 너무 작으면 prefill 단계가 잘려 latency 증가.
MAX_NUM_BATCHED_TOKENS=8192

# 프롬프트당 멀티모달 입력 개수 상한 (JSON). 본 서비스는 썸네일 1장.
# 비디오 클립 다중 프레임 도입 시 image 값 상향 또는 video 키 추가.
LIMIT_MM_PER_PROMPT={"image":1}


# ============================================================================
# [6] 처리량 최적화 / 모델 옵션
# ============================================================================
# Prefix caching — 동일 system/instruction prefix를 공유하는 반복 요청에서
# prefill을 캐시하여 latency↓ throughput↑.
# 본 서비스의 PROMPT_TEMPLATE은 거의 고정 prefix이므로 효과 큼.
# 단, mamba/state-space 계열 모델은 align 모드 실험적 — 이슈 발생 시 false.
ENABLE_PREFIX_CACHING=true

# 추론(reasoning) 모델 파서. Qwen3 thinking 토큰 분리에 사용.
# 본 서비스의 0.8B 모델이 reasoning 모델이 아니면 빈 값 유지.
# 빈 값일 경우 --reasoning-parser 인자 자체가 빠진다.
REASONING_PARSER=

# vLLM 시드. 동일 입력에 대한 재현성 확보용.
VLLM_SEED=0


# ============================================================================
# [7] 추가 vLLM 인자 (자유 입력)
# ============================================================================
# 위 [1]~[6] 변수로 표현되지 않는 vLLM CLI 옵션을 그대로 전달하는 통로.
# 공식 vLLM serve CLI에 추가 인자가 필요할 때 사용. shell 인자 형식 그대로
# 한 줄에 작성하며, 컨테이너 시작 시점에 vllm serve 명령 끝에 붙는다.
# 0.8B 모델 단순 요약 용도라면 대부분 빈 값 유지로 충분.
#
# 자주 쓰이는 옵션과 의미:
#
# --speculative-config '{"method":"mtp","num_speculative_tokens":1}'
#   Multi-Token Prediction(MTP) speculative decoding 활성화. 한 step에서
#   다음 N개 토큰을 예측한 뒤 검증하여 디코딩 속도(token/s)를 높인다.
#   장점: per-token latency↓
#   단점: 동시 요청이 많으면 KV 캐시 점유가 늘어 throughput↓
#   저-동시성 + 빠른 응답 우선일 때 유효. 본 서비스는 보통 미사용.
#
# --max-cudagraph-capture-size 256
#   vLLM이 미리 컴파일하는 CUDA graph 배치 사이즈 상한. 기본 512.
#   mamba/state-space 계열 모델에서 'cuda graph capture > mamba cache' 에러
#   발생 시 수치를 낮추어 우회. 일반 transformer 모델은 건드릴 일 없음.
#
# --enable-expert-parallel
#   Mixture-of-Experts(MoE) 모델 한정. expert layer를 GPU에 분산 배치하여
#   throughput을 높인다. Qwen3.5/3.6-A3B/A17B 같은 MoE 모델에서만 사용.
#   본 서비스의 0.8B dense 모델은 해당 없음.
#
# --language-model-only
#   vision encoder 로딩을 생략하고 LLM 부분만 띄움. VRAM 절약.
#   Qwen3.5/3.6 같은 omni 모델을 텍스트 전용으로 쓸 때만 의미.
#   본 서비스는 썸네일을 입력으로 받으므로 비전 인코더 필수 → 사용 금지.
#
# --mm-encoder-tp-mode data
#   vision encoder를 data parallel 방식으로 분산. 멀티모달 요청 throughput↑.
#   추가 VRAM 필요 → GPU_MEMORY_UTILIZATION 동반 조정.
#   다중 GPU + 대량 이미지 추론 시 의미. 단일 GPU에서는 효과 없음.
#
# --mm-processor-cache-type shm
#   전처리된 이미지(픽셀→토큰)를 공유 메모리에 캐시. 동일 이미지 반복 호출
#   시 prefill 단계 가속. 본 서비스는 매번 다른 썸네일 → 효과 미미.
#
# --mm-processor-cache-gb 0   (또는 1)
#   멀티모달 입력 전처리 결과 캐시 상한(CPU RAM, GiB). vLLM 기본값 4 GiB.
#   본 서비스 워크로드는 알람당 썸네일 1장 = 매번 다른 이미지라 캐시 hit 률
#   거의 0 → 4 GiB 가 유휴 상태로 점유됨(LRU cap 만큼 anon RSS plateau 상승).
#   장점: 컨테이너 anon RSS 약 4 GiB 절감.
#   단점: 백엔드가 동일 이벤트를 재시도/중복 호출하는 경우 hit 가 일부 발생할
#         수 있으며 그땐 0 보다 1 정도가 안전 절충 (≈1 GiB만 점유).
#   권장: pia_summary 단발 호출 패턴이면 0, 백엔드 재시도 정책이 빈번하면 1.
#
#
# --enable-auto-tool-choice --tool-call-parser qwen3_coder
#   OpenAI tools/function-calling 응답 형식 활성화. 본 서비스는 tool 호출
#   하지 않음 → 사용 금지.
#
# --hf-overrides '{"text_config":{"rope_parameters":{...}}}'
#   HuggingFace 모델 config을 런타임에 덮어쓰기. RoPE scaling으로 컨텍스트
#   길이를 모델 한계 이상으로 늘릴 때 사용. 본 서비스는 4K로 충분 → 미사용.
#
# --default-chat-template-kwargs '{"enable_thinking":false}'
#   reasoning 모델의 thinking 토큰을 기본 비활성화. 본 서비스의 0.8B는
#   reasoning 모델이 아니므로 미사용. (REASONING_PARSER 항목 참고)
#
# --mm-processor-kwargs '{"videos_kwargs":{"size":{"longest_edge":...}}}'
#   멀티모달 프로세서 동작 파라미터. 비디오 입력의 최대 해상도 등 조정.
#   본 서비스는 단일 이미지만 처리 → 보통 미사용.
#
# 입력 형식 주의:
#   - 한 줄에 여러 옵션 나열 가능 (공백 구분).
#   - 따옴표가 포함된 JSON 인자는 .env 파일 내 escape 처리에 유의.
#   - 본 변수에 값을 넣으면 컨테이너 시작 로그의 [entrypoint] 줄에서 그대로
#     확인 가능. 잘못된 인자는 vllm이 즉시 종료하므로 docker compose logs로
#     원인 파악.
# EXTRA_VLLM_ARGS=


# ============================================================================
# [8] 네트워킹
# ============================================================================
# 호스트가 컨테이너 8000 포트에 매핑할 외부 포트.
# 동일 호스트에서 다른 vLLM 인스턴스와 충돌 시 변경.
VLLM_PORT=8000


# ============================================================================
# [9] GPU 디바이스 / 자원
# ============================================================================
# 컨테이너에 노출할 GPU index. 콤마 구분으로 다중 지정 가능 (예: 0,1).
NVIDIA_VISIBLE_DEVICES=0

# compose가 reserve할 GPU 개수. NVIDIA_VISIBLE_DEVICES와 일치 권장.
GPU_COUNT=1


# ============================================================================
# [10] HuggingFace 캐시 마운트
# ============================================================================
# 호스트의 HF 캐시 디렉터리. 컨테이너 재기동 시 모델 재다운로드 방지.
# 영구 저장소 / 빠른 디스크에 두는 것 권장.
HF_CACHE_DIR=~/.cache/huggingface
